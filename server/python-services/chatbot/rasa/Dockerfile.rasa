FROM rasa/rasa:3.6.15

WORKDIR /app

USER root

# Copy Rasa project files
COPY rasa/domain.yml ./domain.yml
COPY rasa/config.yml ./config.yml
COPY rasa/credentials.yml ./credentials.yml
COPY rasa/endpoints.cloud.yml ./endpoints.yml
COPY rasa/data/ ./data/

# Models are generated artifacts and are not stored in Git. Train from the
# committed project files so a clean checkout always produces a buildable
# image with a model available at runtime.
RUN mkdir -p /app/models && chown -R 1001:0 /app

USER 1001

RUN rasa train \
    --domain domain.yml \
    --config config.yml \
    --data data \
    --out models \
    --fixed-model-name cloud-model

# Startup script patches dask before Rasa loads to fix model loading error
COPY rasa/startup.py ./startup.py

EXPOSE 5005

# RASA_ACTIONS_URL is injected at deploy time via --set-env-vars
ENTRYPOINT ["python3", "/app/startup.py"]
CMD ["run", "--enable-api", "--cors", "*", "--port", "5005"]
